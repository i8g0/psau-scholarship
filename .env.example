# Google Sheets API (Required for live data from Google Sheets)
# Get these from Google Cloud Console > Service Accounts
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Private key in PKCS#8 PEM format. Supports both:
#   - Literal \n newlines inside double quotes (copy-paste from GCP console)
#   - Actual newlines inside single or double quotes
# IMPORTANT: Rotate this key in GCP IAM if it was ever exposed.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
SPREADSHEET_ID=your-google-sheet-id-from-url

# CORS Origins for Development (Optional)
# Comma-separated list of allowed origins for CORS in development mode.
# Example: http://localhost:5173,http://localhost:3001
# Leave empty to restrict to same-origin only.
CORS_ORIGINS=

# Disclaimer Form URL (Optional)
# Link to the Google Form for admitted students who haven't filled it yet.
# Defaults to: https://forms.gle/nvRGFGxC611WHja1A
NEXT_PUBLIC_DISCLAIMER_FORM_URL=https://forms.gle/nvRGFGxC611WHja1A