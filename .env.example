# Google Sheets API (Required for live data from Google Sheets)
# Get these from Google Cloud Console > Service Accounts
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
SPREADSHEET_ID=your-google-sheet-id-from-url

# Admin Authentication (Required for /admin panel)
# Generate a secure random string for ADMIN_SECRET (32+ chars recommended)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-admin-password
ADMIN_SECRET=your-32-character-random-secret-string-here

# Optional: Next.js Telemetry (disable if desired)
# NEXT_TELEMETRY_DISABLED=1